+  // ---- SPIKE (Phase 2 experiment) ----
+  async "spike-out-setup"() {
+    const out = MailServices.outgoingServer;
+    const account = MailServices.accounts.findAccountForServer(jmapServers()[0]);
+    const identity = account.defaultIdentity;
+    // An SMTP server nobody can reach, made the default: any fallback lands here.
+    const smtp = out.createServer("smtp");
+    smtp.QueryInterface(Ci.nsISmtpServer).hostname = "fallback.invalid";
+    out.defaultServer = smtp;
+    const jmap = out.createServer("jmap");
+    identity.smtpServerKey = jmap.key;
+    const via = out.getServerByIdentity(identity);
+    return { jmapKey: jmap.key, smtpKey: smtp.key, via: `${via?.key}:${via?.type}` };
+  },
+
+  async "spike-out-check"(ctx) {
+    const out = MailServices.outgoingServer;
+    const identity = MailServices.accounts.findAccountForServer(jmapServers()[0]).defaultIdentity;
+    let list;
+    try {
+      list = out.servers.map(s => `${s.key}:${s.type}`);
+    } catch (e) {
+      list = `THROWS ${e}`;
+    }
+    const via = out.getServerByIdentity(identity);
+    const result = { list, identityKey: identity.smtpServerKey, via: `${via?.key}:${via?.type}` };
+    if (ctx.args?.recreate && via?.type != "jmap") {
+      // Recreate the dropped server under the same key.
+      const key = identity.smtpServerKey;
+      const keys = Services.prefs.getCharPref("mail.smtpservers", "").split(",").filter(k => k && k != key);
+      Services.prefs.setCharPref("mail.smtpservers", keys.join(","));
+      const again = out.createServer("jmap");
+      const via2 = out.getServerByIdentity(identity);
+      result.recreated = { key: again.key, via: `${via2?.key}:${via2?.type}` };
+    }
+    return result;
+  },
+
