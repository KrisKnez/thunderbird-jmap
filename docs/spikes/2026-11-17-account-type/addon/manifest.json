{
  "manifest_version": 3,
  "name": "JMAP account-type spike (throwaway)",
  "version": "0.0.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "jmap-spike@example.invalid",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "experiment_apis": {
    "jmapSpike": {
      "schema": "api/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["jmapSpike"]],
        "script": "api/implementation.js",
        "events": ["startup"]
      }
    }
  }
}
